IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

WISE_API_TOKEN=

# QUOTE EVERY SECRET. `node --env-file` treats an unquoted # as a start-of-comment and
# silently truncates the value there. A 32-char password arriving as 7 chars reads exactly
# like a wrong password, and cost a full session to track down. Use scripts/set-env-value.js
# to write one, or wrap it in single quotes by hand.
#
# Actual needs TWO passwords when the budget file is end-to-end encrypted:
#   ACTUAL_PASSWORD        - server login, passed to init()
#   ACTUAL_BUDGET_PASSWORD - file encryption, passed to downloadBudget()
# Supplying only the first logs in successfully and then fails at download.
ACTUAL_SERVER_URL=
ACTUAL_PASSWORD=''
ACTUAL_BUDGET_PASSWORD=''
ACTUAL_SYNC_ID=

# The last date you reconciled, YYYY-MM-DD. Rows on or before it are skipped, so a real
# import never backfills an already-balanced account. Required for a real import; the dry
# run works without it. Reconciliation itself stays a human action — bump this by hand.
ACTUAL_MAIL_RECONCILED_THROUGH=

# Path to the account map. Every distinct row account needs a key, and every Trust pot
# needs a "pot:<Pot Name>" key pointing at that pot's own Actual account — pot moves are
# written as two-sided transfers. `node --env-file=.env scripts/list-accounts.js`
# prints the ids.
ACTUAL_MAIL_MAPPING=./mapping.json
